# Variáveis públicas — configure no Vercel e copie para .env.local durante o desenvolvimento.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_publica

# Somente no servidor Vercel. Nunca comece estes nomes com VITE_.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_sua_chave_secreta
CRON_SECRET=gere-uma-string-aleatoria-com-no-minimo-16-caracteres

# E-mail por Resend (opcional)
RESEND_API_KEY=re_sua_chave
EMAIL_FROM=Nitida <lembretes@seu-dominio.com>

# SMS/WhatsApp por Twilio (opcional)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM=+15551234567
